# This file IS tracked in the repo, with placeholder values only.
# Fill in your own values locally. Never commit a real TS_AUTHKEY here —
# pass secrets in your shell instead (compose prefers shell env over .env):
#   export TS_AUTHKEY=tskey-auth-... TESTER_AUTHORIZED_KEY='ssh-ed25519 ...'
#   docker compose up -d --build
#
# VERSION — the version of this sandbox. Used as the image tag
# (sandbox:<VERSION>) and stamped on the image as a label. Bump it when you
# change the Dockerfile or compose.yml in a way worth telling apart.
VERSION=1.0.0
#
# TS_AUTHKEY — Tailscale auth key, only needed on FIRST boot (or after a
# `docker compose down -v`). Create one at https://login.tailscale.com/admin/settings/keys
# (Generate auth key). Use a REUSABLE key: a single-use key works once and
# then cannot re-join if the tailscale-state volume is ever lost.
# Leave empty to start the box without joining the tailnet — you can run
# `tailscale up` inside the container later instead.
TS_AUTHKEY=
#
# TS_HOSTNAME — the name this box gets on the tailnet. Change it per machine
# (e.g. sandbox-mac, sandbox-win) if you run a sandbox on more than one host,
# otherwise the second one will fight the first for the same name.
TS_HOSTNAME=sandbox
#
# TESTER_AUTHORIZED_KEY — your SSH public key, one line, e.g.
#   ssh-ed25519 AAAAC3NzaC1lZDI1NTE5AAAAI... you@your-laptop
# Set it before the FIRST boot. It seeds tester's authorized_keys, which then
# lives in the tester-ssh volume and survives recreates. A public key is safe
# to commit — it is not a secret.
TESTER_AUTHORIZED_KEY=
#
# Optional Tailscale extras (see the entrypoint heredoc in the Dockerfile):
# TS_ACCEPT_ROUTES=false
# TS_SSH=false
# TS_ADVERTISE_ROUTES=
#
TZ=Europe/London
